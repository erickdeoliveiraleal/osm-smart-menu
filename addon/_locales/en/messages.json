{
    "extensionName": {
        "message": "OSM Smart Menu"
    },
    "extensionShortName": {
        "message": "OSMenu"
    },
    "extensionDescription": {
        "message": "Helps OpenStreetMap contributors to easily switch between different maps and analysis tools from the community."
    },
    "extensionStoreDescription": {
        "message": "When you click the menu's button, this extension will <strong>detect</strong> OpenStreetMap parameters inside the current page and will <strong>generate</strong> a list of related maps and tools with these parameters.\n\nRecognized parameters include:\n<ul>\n<li>Map coordinates (zoom, latitude and longitude)</li>\n<li>OSM elements (node id, way id, relation id and changeset id)</li>\n<li>User names and GPS traces id</li>\n</ul>\nIf you are not sure which website will be recognized, try going to https://www.openstreetmap.org/ before clicking on the menu.\n\n<em>The OpenStreetMap logo is a trademark of the OpenStreetMap Foundation, and is used with their permission. This project is not endorsed by or affiliated with the OpenStreetMap Foundation.</em>",
        "description": "Description shown in Chrome and Firefox's extension download page"
    },
    "loading": {
        "message": "Loading...\nIf this does not stop loading, reload the page and try again.",
        "description": "Shown in popup shortly before menu appears."
    },
    "newOptionDetected_notice": {
        "message": "Would you like to add this website in the menu?",
        "description": "Shown in popup (before the button) when an unknown website seems compatible with OpenStreetMap"
    },
    "newOptionDetected_buttonText": {
        "message": "Add link",
        "description": "Shown in popup (inside the button) when an unknown website seems compatible with OpenStreetMap"
    },
    "newOptionDetected_added": {
        "message": "Added as $PAGE_TITLE$",
        "description": "Shown in popup when an unknown website seems compatible with OpenStreetMap. After the button is clicked.",
        "placeholders": {
            "PAGE_TITLE": {
                "content": "$1",
                "example": "OpenStreetMap"
            }
        }
    },
    "configurationLink": {
        "message": "Configuration",
        "description": "Link to configuration page inside main popup."
    },
    "config_editButton": {
        "message": "Edit",
        "description": "Text inside 'edit button' in configuration page"
    },
    "config_saveButton": {
        "message": "Save",
        "description": "Text inside 'save button' in configuration page"
    },
    "config_deleteButton": {
        "message": "Delete",
        "description": "Text inside 'delete button' in configuration page"
    },
    "config_linkDeleted": {
        "message": "Link $LINK_NAME$ deleted. Click here to undo.",
        "description": "Shown inline when a link is deleted inside configuration page",
        "placeholders": {
            "LINK_NAME": {
                "content": "$1",
                "example": "OpenStreetMap"
            }
        }
    },
    "config_pattern_formTitle": {
        "message": "Advanced Option Creation (experimental)",
        "description": "Form Legend/Title"
    },
    "config_pattern_name": {
        "message": "Name",
        "description": "Input label"
    },
    "config_pattern_urlTemplate": {
        "message": "URL Template",
        "description": "Input label"
    },
    "config_pattern_createOption": {
        "message": "Create option",
        "description": "Button"
    },
    "error_noAccess": {
        "message": "ERROR: Could not find or access current page.\nIf this page is still loading, try again.\nIf this is unexpected, please report it in $EXTENSION_SITE$.",
        "description": "Error shown inside popup when the current page cannot be accessed (technical exception)",
        "placeholders": {
            "EXTENSION_SITE": {
                "content": "$1",
                "example": "github.com/jgpacker/osm-smart-menu/"
            }
        }
    },
    "error_incompatibleWebsite": {
        "message": "No map or OpenStreetMap parameters were found.\nIf this is unexpected, you can report it in $EXTENSION_SITE$.",
        "description": "Error shown inside popup when appropriate",
        "placeholders": {
            "EXTENSION_SITE": {
                "content": "$1",
                "example": "github.com/jgpacker/osm-smart-menu/"
            }
        }
    },
    "error_noInformationExtracted": {
        "message": "The website was recognized, but no parameters were found.\nIf this is a map, try to move it a little to initialize it's parameters.\nIf this looks like a bug, please report it in $EXTENSION_SITE$.",
        "description": "Error shown inside popup when appropriate",
        "placeholders": {
            "EXTENSION_SITE": {
                "content": "$1",
                "example": "github.com/jgpacker/osm-smart-menu/"
            }
        }
    },
    "noEnabledCompatibleLinksFound": {
        "message": "None of the enabled links are compatible with the parameters found in this page.",
        "description": "Shown in popup when there aren't any enabled links that support the parameters found in the current page."
    },
    "button_showEnabledLinks": {
        "message": "Show enabled links using additional parameters",
        "description": "Shown in popup below some errors to allow users to see enabled links."
    },
    "button_showOtherEnabledLinks": {
        "message": "Show the rest of the enabled links using additional parameters",
        "description": "Shown in popup below the list of links; to see other enabled links with additional parameters."
    },
