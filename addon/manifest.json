{
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",

  "minimum_chrome_version": "121",

  "author": "João Guilherme Packer, Erick de Oliveira Leal",
  "homepage_url": "https://github.com/erickdeoliveiraleal/osm-smart-menu",
  "version": "0.29.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "osm-smart-menu@jgpacker.me.br",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "background-listeners-setup.js",
    "scripts": ["background-listeners-setup.js"]
  },

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/index.html"
  },

  "options_ui": {
    "page": "options/index.html"
  },

  "commands": { "_execute_action": {} },

  "manifest_version": 3
}
