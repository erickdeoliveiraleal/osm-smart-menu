{
  "name": "osm-smart-menu",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "tscompile": "svelte-check && webpack --mode=production",
    "watch": "webpack --mode=development --watch",
    "lint:ext": "web-ext lint --source-dir addon",
