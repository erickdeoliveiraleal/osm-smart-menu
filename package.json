    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/dragula": "^3.7.5",
    "@types/jest": "^29.5.14",
    "@types/webextension-polyfill": "^0.12.6",
    "jest": "^29.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-loader": "^3.2.4",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "web-ext": "^10.7.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
